# Copy to .env for local development. On your host (Render, Railway, etc.)
# set these as environment variables instead.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (use the session pooler on port 5432, not the transaction pooler on 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional but recommended: Supabase → Project Settings → Database → SSL
# Configuration → Download certificate, then paste the PEM here (\n for newlines)
# so the server verifies the database's TLS certificate.
SUPABASE_DB_CA=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...   # the public "anon" key — NOT the service_role key

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@kandledigital.com
